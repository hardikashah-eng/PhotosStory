<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ep.title }} · Thursday PhotoStory</title>
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="no-referrer">
<meta property="og:type" content="article">
<meta property="og:title" content="🎬 {{ ep.title }}">
<meta property="og:description" content="{{ ep.tagline }} Story · quiz · sing-along.">
{% if cover_url %}<meta property="og:image" content="{{ cover_url }}">
<meta property="og:image:type" content="image/jpeg">{% endif %}
<style>
  :root {
    --paper: #fbf6ec; --ink: #2b2420; --muted: #7a6e64; --accent: #d9572b;
    --accent-soft: #fde3d6; --good: #2f8f5b; --bad: #c0392b; --card: #fffdf8;
    --hand: "Segoe Print", "Bradley Hand", "Marker Felt", "Comic Neue", cursive;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--serif); line-height: 1.6; }
  main { max-width: 860px; margin: 0 auto; padding: 32px 20px 80px; }
  header { text-align: center; padding: 24px 0 8px; }
  .kicker { font-family: var(--sans); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  h1 { font-size: clamp(32px, 6vw, 54px); line-height: 1.1; margin: 10px 0 8px; }
  .tagline { font-style: italic; color: var(--muted); font-size: 19px; margin: 0; }
  .theme { display: inline-block; margin-top: 14px; font-family: var(--sans); font-size: 13px; background: var(--accent-soft); color: var(--accent); padding: 4px 12px; border-radius: 99px; }
  nav { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin: 26px 0 10px; font-family: var(--sans); }
  nav a { color: var(--ink); text-decoration: none; border: 1.5px solid var(--ink); border-radius: 99px; padding: 6px 14px; font-size: 14px; font-weight: 600; }
  nav a:hover { background: var(--ink); color: var(--paper); }
  h2 { font-size: 30px; margin: 56px 0 6px; display: flex; align-items: center; gap: 10px; }
  h2::after { content: ""; flex: 1; height: 2px; background: repeating-linear-gradient(90deg, var(--ink) 0 6px, transparent 6px 12px); opacity: .25; }
  .intro, .ending { font-size: 19px; }
  .beat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 32px; align-items: center; margin: 40px 0; }
  .beat:nth-child(even) .polaroid { order: 2; }
  .polaroid { background: #fff; padding: 12px 12px 14px; box-shadow: 0 6px 22px rgba(43,36,32,.16); transform: rotate(-2deg); transition: transform .25s; }
  .beat:nth-child(even) .polaroid { transform: rotate(1.8deg); }
  .polaroid:hover { transform: rotate(0) scale(1.02); }
  .polaroid img { width: 100%; display: block; background: #eee; }
  .polaroid figcaption { font-family: var(--hand); font-size: 17px; line-height: 1.35; padding-top: 10px; text-align: center; }
  .beat h3 { font-size: 22px; margin: 0 0 6px; }
  .beat .num { font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--accent); letter-spacing: .12em; text-transform: uppercase; }
  .quiz-q { background: var(--card); border: 1.5px solid #e6dccd; border-radius: 14px; padding: 18px 20px; margin: 16px 0; }
  .quiz-q p.q { font-weight: 700; margin: 0 0 12px; font-size: 18px; }
  .opts { display: grid; gap: 8px; }
  .opts button { font: 600 16px var(--sans); text-align: left; padding: 10px 14px; border-radius: 10px; border: 1.5px solid #d9cdbb; background: #fff; color: var(--ink); cursor: pointer; }
  .opts button:hover:not(:disabled) { border-color: var(--ink); }
  .opts button.right { background: #e3f4ea; border-color: var(--good); color: var(--good); }
  .opts button.wrong { background: #fbe4e1; border-color: var(--bad); color: var(--bad); text-decoration: line-through; }
  .opts button:disabled { cursor: default; }
  .explain { display: none; margin: 10px 0 0; font-family: var(--sans); font-size: 15px; color: var(--muted); }
  .answered .explain { display: block; }
  .score { font-family: var(--sans); font-weight: 700; text-align: center; font-size: 18px; margin-top: 18px; min-height: 1.5em; }
  .song { background: var(--ink); color: var(--paper); border-radius: 18px; padding: 28px 30px; }
  .song h3 { margin: 0; font-size: 26px; }
  .song .meta { font-family: var(--sans); font-size: 14px; opacity: .75; margin: 4px 0 18px; }
  .song .verse, .song .chorus { white-space: pre-line; margin: 0 0 18px; font-size: 18px; }
  .song .chorus { font-weight: 700; color: #ffcf8a; padding-left: 14px; border-left: 3px solid #ffcf8a; }
  .song .label { font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .6; display: block; margin-bottom: 2px; font-weight: 400; color: var(--paper); }
  .teaser { text-align: center; margin-top: 56px; font-style: italic; color: var(--muted); font-size: 18px; }
  footer { text-align: center; font-family: var(--sans); font-size: 12px; color: var(--muted); margin-top: 30px; }
  @media (max-width: 680px) {
    .beat { grid-template-columns: 1fr; gap: 16px; }
    .beat:nth-child(even) .polaroid { order: 0; }
  }
  @media print { nav, .score { display: none; } .explain { display: block; } .polaroid { box-shadow: none; border: 1px solid #ddd; } }
</style>
</head>
<body>
<main>
  <header>
    <div class="kicker">Thursday PhotoStory · {{ date_label }}</div>
    <h1>{{ ep.title }}</h1>
    <p class="tagline">{{ ep.tagline }}</p>
    <span class="theme">Starring {{ family_name }} · {{ ep.theme }}</span>
  </header>
  <nav>
    <a href="#story">📖 Story</a><a href="#quiz">🧠 Quiz</a><a href="#song">🎤 Song</a>
  </nav>

  <section id="story">
    <h2>📖 The Story</h2>
    <p class="intro">{{ ep.story_intro }}</p>
    <div class="beats">
    {% for beat in ep.story %}
      <article class="beat">
        <figure class="polaroid">
          <img src="{{ photo_src(beat.photo) }}" alt="Photo {{ beat.photo }}" loading="lazy">
          <figcaption>{{ captions[beat.photo].caption }} {{ captions[beat.photo].emoji }}</figcaption>
        </figure>
        <div>
          <div class="num">Chapter {{ loop.index }}</div>
          <h3>{{ beat.heading }}</h3>
          <p>{{ beat.text }}</p>
        </div>
      </article>
    {% endfor %}
    </div>
    <p class="ending">{{ ep.story_ending }}</p>
  </section>

  <section id="quiz">
    <h2>🧠 Family Quiz</h2>
    {% for q in ep.quiz %}
    <div class="quiz-q" data-answer="{{ q.answer }}">
      <p class="q">{{ loop.index }}. {{ q.question }}</p>
      <div class="opts">
        {% for opt in q.options %}<button type="button" data-i="{{ loop.index0 }}">{{ "ABCD"[loop.index0] }}. {{ opt }}</button>{% endfor %}
      </div>
      <p class="explain">{{ q.explanation }}</p>
    </div>
    {% endfor %}
    <div class="score" id="score"></div>
  </section>

  <section id="song">
    <h2>🎤 Sing-Along</h2>
    <div class="song">
      <h3>{{ ep.song.title }}</h3>
      <div class="meta">{{ ep.song.style }} · {{ ep.song.tune_hint }}</div>
      {% for verse in ep.song.verses %}
        <p class="verse"><span class="label">Verse {{ loop.index }}</span>{{ verse }}</p>
        <p class="chorus"><span class="label">Chorus — everybody!</span>{{ ep.song.chorus }}</p>
      {% endfor %}
    </div>
  </section>

  <p class="teaser">🔮 {{ ep.next_week_teaser }}</p>
  <footer>Made with love (and a little AI) from {{ family_name }}'s photo library.</footer>
</main>
<script>
(() => {
  const qs = [...document.querySelectorAll(".quiz-q")];
  let done = 0, right = 0;
  const score = document.getElementById("score");
  qs.forEach(q => {
    const ans = +q.dataset.answer;
    q.querySelectorAll("button").forEach(b => b.addEventListener("click", () => {
      const pick = +b.dataset.i;
      q.querySelectorAll("button").forEach(x => { x.disabled = true; if (+x.dataset.i === ans) x.classList.add("right"); });
      if (pick !== ans) b.classList.add("wrong"); else right++;
      q.classList.add("answered");
      if (++done === qs.length) {
        const msg = right === qs.length ? "Perfect score! 🏆 Family genius detected."
          : right >= qs.length / 2 ? "Great job! 🎉" : "Nice try — the photos are sneaky! 😄";
        score.textContent = `${right} / ${qs.length} — ${msg}`;
      }
    }));
  });
})();
</script>
</body>
</html>
