<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ ep.title }}</title></head>
<body style="margin:0;padding:0;background:#fbf6ec;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fbf6ec;">
<tr><td align="center" style="padding:28px 14px;">
<table role="presentation" width="520" cellpadding="0" cellspacing="0" style="max-width:520px;width:100%;font-family:Georgia,'Times New Roman',serif;color:#2b2420;">
  <tr><td align="center" style="font-family:Arial,sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#d9572b;font-weight:bold;padding-bottom:8px;">This week's PhotoStory is ready · {{ date_label }}</td></tr>
  <tr><td style="background:#fff;padding:12px;box-shadow:0 2px 12px rgba(0,0,0,.08);">
    <a href="{{ page_url }}"><img src="cid:cover@photostory" alt="Cover photo" width="496" style="width:100%;max-width:496px;height:auto;display:block;border:0;"></a>
    <div style="font-size:26px;font-weight:bold;line-height:1.2;padding:16px 6px 4px;">{{ ep.title }}</div>
    <div style="font-size:16px;font-style:italic;color:#7a6e64;padding:0 6px 16px;">{{ ep.tagline }}</div>
  </td></tr>
  <tr><td align="center" style="padding:22px 0 8px;">
    <a href="{{ page_url }}" style="display:inline-block;background:#2b2420;color:#fbf6ec;font-family:Arial,sans-serif;font-weight:bold;font-size:16px;text-decoration:none;padding:14px 26px;border-radius:99px;">📖 Open the episode</a>
  </td></tr>
  <tr><td align="center" style="padding:6px 0 18px;">
    <a href="{{ whatsapp_url }}" style="display:inline-block;background:#25D366;color:#ffffff;font-family:Arial,sans-serif;font-weight:bold;font-size:16px;text-decoration:none;padding:14px 26px;border-radius:99px;">💬 Share on WhatsApp</a>
  </td></tr>
  <tr><td style="font-family:Arial,sans-serif;font-size:13px;color:#7a6e64;line-height:1.6;padding:8px 4px;border-top:2px dashed #e0d4c3;">
    <b>Ready-to-paste message:</b><br>
    <span style="color:#2b2420;">{{ share_text | nl2br }}</span><br><br>
    {% if expires %}🔒 This link expires on <b>{{ expires }}</b>.{% else %}🔒 Unlisted link — it can't be found or guessed, but anyone you send it to can open it, so share it with family only.{% endif %}
    Tap "Share on WhatsApp" on your phone to pick your family groups.
  </td></tr>
</table>
</td></tr></table>
</body></html>
