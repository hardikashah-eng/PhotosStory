<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ ep.title }}</title></head>
<body style="margin:0;padding:0;background:#fbf6ec;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fbf6ec;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;font-family:Georgia,'Times New Roman',serif;color:#2b2420;">
  <tr><td align="center" style="padding:8px 0 4px;font-family:Arial,sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#d9572b;font-weight:bold;">Thursday PhotoStory · {{ date_label }}</td></tr>
  <tr><td align="center" style="font-size:34px;line-height:1.15;font-weight:bold;padding:6px 0;">{{ ep.title }}</td></tr>
  <tr><td align="center" style="font-size:17px;font-style:italic;color:#7a6e64;padding-bottom:6px;">{{ ep.tagline }}</td></tr>
  <tr><td align="center" style="font-family:Arial,sans-serif;font-size:13px;color:#d9572b;padding-bottom:18px;">Starring {{ family_name }} · {{ ep.theme }}</td></tr>
  {% if attached %}<tr><td align="center" style="font-family:Arial,sans-serif;font-size:13px;color:#7a6e64;padding-bottom:18px;">🎮 Open the attached <b>photostory.html</b> to play the quiz interactively.</td></tr>{% endif %}

  <tr><td style="font-size:22px;font-weight:bold;padding:14px 0 6px;border-top:2px dashed #e0d4c3;">📖 The Story</td></tr>
  <tr><td style="font-size:17px;line-height:1.6;padding-bottom:10px;">{{ ep.story_intro }}</td></tr>
  {% for beat in ep.story %}
  <tr><td style="padding:14px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;box-shadow:0 2px 10px rgba(0,0,0,.08);">
      <tr><td style="padding:12px 12px 0;"><img src="cid:{{ cid(beat.photo) }}" alt="Photo {{ beat.photo }}" width="576" style="width:100%;max-width:576px;height:auto;display:block;border:0;"></td></tr>
      <tr><td align="center" style="padding:10px 16px 4px;font-family:'Comic Sans MS','Marker Felt',cursive;font-size:16px;">{{ captions[beat.photo].caption }} {{ captions[beat.photo].emoji }}</td></tr>
      <tr><td style="padding:8px 18px 18px;">
        <div style="font-family:Arial,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#d9572b;font-weight:bold;">Chapter {{ loop.index }}</div>
        <div style="font-size:19px;font-weight:bold;padding:2px 0 4px;">{{ beat.heading }}</div>
        <div style="font-size:16px;line-height:1.6;">{{ beat.text }}</div>
        {% set v = voices.get(beat.photo) %}{% if v %}<div style="margin-top:10px;font-size:15px;font-style:italic;color:#7a6e64;">💬 {{ v.speaker }}: “{{ v.line }}”</div>{% endif %}
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}
  <tr><td style="font-size:17px;line-height:1.6;padding:6px 0 10px;">{{ ep.story_ending }}</td></tr>

  <tr><td style="font-size:22px;font-weight:bold;padding:18px 0 6px;border-top:2px dashed #e0d4c3;">🧠 Family Quiz</td></tr>
  {% for q in ep.quiz %}
  <tr><td style="padding:8px 0 10px;font-size:16px;line-height:1.5;">
    <b>{{ loop.index }}. {{ q.question }}</b><br>
    {% for opt in q.options %}<span style="font-family:Arial,sans-serif;font-size:15px;">&nbsp;&nbsp;{{ "ABCD"[loop.index0] }}. {{ opt }}</span><br>{% endfor %}
  </td></tr>
  {% endfor %}

  <tr><td style="font-size:22px;font-weight:bold;padding:18px 0 10px;border-top:2px dashed #e0d4c3;">🎤 Sing-Along</td></tr>
  <tr><td style="background:#2b2420;color:#fbf6ec;padding:22px 24px;border-radius:12px;">
    <div style="font-size:22px;font-weight:bold;">{{ ep.song.title }}</div>
    <div style="font-family:Arial,sans-serif;font-size:13px;color:#cfc4b8;padding:2px 0 14px;">{{ ep.song.style }} · {{ ep.song.tune_hint }}</div>
    {% for verse in ep.song.verses %}
      <div style="font-size:16px;line-height:1.6;padding-bottom:12px;">{{ verse | nl2br }}</div>
      <div style="font-size:16px;line-height:1.6;padding:0 0 14px 12px;border-left:3px solid #ffcf8a;color:#ffcf8a;font-weight:bold;">{{ ep.song.chorus | nl2br }}</div>
    {% endfor %}
  </td></tr>

  {% if quote %}<tr><td align="center" style="font-size:18px;font-style:italic;padding:26px 10px 4px;">“{{ quote.text }}”<br><span style="font-family:Arial,sans-serif;font-size:12px;font-style:normal;letter-spacing:1px;color:#d9572b;">— {{ quote.author }}</span></td></tr>
  <tr><td align="center" style="font-size:15px;color:#2b2420;padding:6px 10px 0;">❤️ {{ ep.collage_message }}</td></tr>{% endif %}
  <tr><td align="center" style="font-size:16px;font-style:italic;color:#7a6e64;padding:26px 0 8px;">🔮 {{ ep.next_week_teaser }}</td></tr>

  <tr><td style="padding:20px 0 0;border-top:2px dashed #e0d4c3;font-family:Arial,sans-serif;font-size:13px;color:#7a6e64;">
    <b>🙈 Answer key (no peeking!):</b><br>
    {% for q in ep.quiz %}{{ loop.index }}. {{ "ABCD"[q.answer] }} — {{ q.explanation }}<br>{% endfor %}
  </td></tr>
</table>
</td></tr></table>
</body></html>
